# Jarvis local development/deployment template
#
# Copy this file to `.env` and change paths/model tags for the target machine.
# Do not put real tokens, passwords, API keys, or client data in this file.
# `.env` is intentionally ignored by Git.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
NOPUS_PROSE_FILTER=true

# Ollama (required for normal chat and planning)
# This must exactly match a tag returned by `ollama list` on this machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3.1:8b
# Leave blank unless running a separately approved benchmark.
OLLAMA_CANDIDATE_MODEL=
OLLAMA_KEEP_ALIVE=3600
OLLAMA_REQUEST_TIMEOUT=300

# Session behaviour
SESSION_MAX_TURNS=20

# Controlled local workspace (required)
# Relative paths resolve from the repository root. Absolute local paths are also supported.
DEFAULT_WORKSPACE_DIR=./workspace
SANDBOX_MODE=true
SANDBOX_ROOTS=./sandbox,./workspace
WORKSPACE_MAX_DOCUMENT_BYTES=10485760
WORKSPACE_DOCUMENT_EXTENSIONS=.txt,.md,.csv,.json,.yaml,.yml,.log

# Safety and audit trail
SAFE_MODE=strict
EMERGENCY_STOP_KEYWORD=JARVIS STOP
DRY_RUN=false
AUDIT_LOG_PATH=./logs/audit.log

# Local memory and knowledge graph
KNOWLEDGE_GRAPH_PATH=./core/memory/graph.db
LOCAL_MEMORY_PATH=./core/memory/local_memory.db
LOCAL_MEMORY_ENABLED=true
KNOWLEDGE_CORPUS_DIRS=knowledge,workspace
GRAPH_WATCH=false
MAX_GRAPH_HOPS=3
GRAPH_TOP_K=8
GRAPH_ENABLED=true

# Local sub-agent profiles
AGENTS_BLUEPRINT_PATH=./agents/agents_blueprint.yaml
AGENT_BASELINE_TIMEOUT=60
POETRY_VENV_PATH=./.venvs

# Voice input (optional; required only for `--mode audio`)
WHISPER_MODEL=base
# Use `cuda` + `float16` only when the local Python/Torch installation sees an NVIDIA GPU.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_INPUT_DEVICE=-1
AUDIO_OUTPUT_DEVICE=-1
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION=30
AUDIO_SILENCE_THRESHOLD=0.01
AUDIO_SILENCE_DURATION=1.5

# Voice output (optional; configure one engine before `--mode audio`)
# Piper example: use a machine-specific executable path on Windows.
TTS_ENGINE=piper
PIPER_BINARY_PATH=
PIPER_VOICE_MODEL=
# Kokoro alternative: asset files normally live in ./models/ and are Git-ignored.
KOKORO_VOICE_MODEL=kokoro-v1.0.onnx
KOKORO_VOICES_FILE=voices-v1.0.bin
KOKORO_VOICE_ID=bf_emma
KOKORO_LANG_CODE=en-us

# Optional integrations. Keep blank/off unless the integration is intentionally configured.
# Never commit real values to Git.
GIT_TOKEN=
GIT_USER_EMAIL=
GIT_USER_NAME=
SKYVERN_BASE_URL=http://localhost:8000/api/v1
SKYVERN_API_KEY=
SKYVERN_TASK_TIMEOUT=120
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
