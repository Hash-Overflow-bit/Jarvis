# =============================================================================
# Jarvis .env — Windows 11 Client Configuration
# Copy this file and rename it to .env
# Fill in your own paths. NEVER commit .env to git.
# =============================================================================

# --- General ---
ENVIRONMENT=production           # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_KEEP_ALIVE=3600           # Keep model in VRAM (seconds). 0 = unload after use.

# --- Whisper STT ---
# For NVIDIA GPU (recommended): set WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16
# For CPU only: set WHISPER_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=base
WHISPER_DEVICE=cuda              # cuda (NVIDIA GPU) | cpu (no GPU)
WHISPER_COMPUTE_TYPE=float16     # float16 (GPU) | int8 (CPU)

# --- Piper TTS ---
# Download piper.exe for Windows from: https://github.com/rhasspy/piper/releases
# Place piper.exe inside the Jarvis project folder (e.g. C:\...\Jarvis\piper\piper.exe)
# Download voice model (.onnx + .onnx.json) from:
#   https://huggingface.co/rhasspy/piper-voices/tree/main/en/en_US/lessac/medium
# Place the .onnx and .onnx.json files in: C:\...\Jarvis\models\
PIPER_BINARY_PATH=C:\Users\wmjar\OneDrive\Desktop\Jarvis\piper\piper.exe
PIPER_VOICE_MODEL=en_US-lessac-medium.onnx

# --- Audio Device ---
AUDIO_INPUT_DEVICE=-1            # -1 = system default microphone
AUDIO_OUTPUT_DEVICE=-1           # -1 = system default speaker
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION=30
AUDIO_SILENCE_THRESHOLD=0.01
AUDIO_SILENCE_DURATION=1.5

# --- Session ---
SESSION_MAX_TURNS=20
JARVIS_SYSTEM_PROMPT=You are Jarvis, a helpful local AI assistant. Be concise and precise.

# --- Sandbox (M2+) ---
# This is the ONLY folder Jarvis is allowed to read/write files in.
SANDBOX_ROOTS=C:\Users\wmjar\OneDrive\Desktop\Jarvis\sandbox

# --- GitHub & Poetry (M3+) ---
GIT_TOKEN=                                        # Optional: GitHub personal access token for private repos
DEFAULT_WORKSPACE_DIR=C:\Users\wmjar\OneDrive\Desktop\Jarvis\workspace
POETRY_VENV_PATH=C:\Users\wmjar\OneDrive\Desktop\Jarvis\.venvs
GIT_USER_EMAIL=jarvis@local.ai
GIT_USER_NAME=Jarvis

# --- Safety & Auditing (M4+) ---
SAFE_MODE=strict                 # strict (confirm all) | permissive (high risk only) | off
EMERGENCY_STOP_KEYWORD=JARVIS STOP
DRY_RUN=false
AUDIT_LOG_PATH=C:\Users\wmjar\OneDrive\Desktop\Jarvis\logs\audit.log
