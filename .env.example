# =============================================================================
# Jarvis .env — macOS Development Machine
# Copy this to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# --- General ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR

# --- Ollama LLM ---
# Client config: OLLAMA_URL = "http://localhost:11434/api/generate"
# We store the base URL only; /api/generate vs /api/chat is chosen per call.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1            # Matches client: MODEL_NAME = "llama3.1"
OLLAMA_KEEP_ALIVE=3600           # Keep model in VRAM (seconds). 0 = unload after use.

# --- Whisper STT ---
# Client config: WHISPER_MODEL_SIZE = "base"
WHISPER_MODEL=base               # Matches client: tiny | base | small | medium
WHISPER_DEVICE=cpu               # cpu (macOS) | cuda (Windows with NVIDIA GPU)
WHISPER_COMPUTE_TYPE=int8        # int8 (CPU) | float16 (GPU)

# --- Piper TTS ---
# Client config: PIPER_MODEL_PATH = "en_US-lessac-medium.onnx" (filename only)
# If PIPER_VOICE_MODEL is a filename only (no path separators), it resolves to
# PROJECT_ROOT/models/<filename> automatically.
# Download piper binary from: https://github.com/rhasspy/piper/releases
# Download voice model from: https://huggingface.co/rhasspy/piper-voices
PIPER_BINARY_PATH=/usr/local/bin/piper
PIPER_VOICE_MODEL=en_US-lessac-medium.onnx   # Matches client: PIPER_MODEL_PATH

# --- Audio Device ---
# Set to -1 to use system default. Run scripts/list_audio_devices.py to find indices.
AUDIO_INPUT_DEVICE=-1            # Microphone device index (-1 = default)
AUDIO_OUTPUT_DEVICE=-1           # Speaker device index (-1 = default)
AUDIO_SAMPLE_RATE=16000          # Matches client: SAMPLE_RATE = 16000
AUDIO_CHANNELS=1                 # Matches client: CHANNELS = 1
AUDIO_CHUNK_DURATION=30          # Max recording seconds per utterance
AUDIO_SILENCE_THRESHOLD=0.01     # RMS amplitude below this = silence
AUDIO_SILENCE_DURATION=1.5       # Seconds of silence before stopping recording

# --- Session ---
SESSION_MAX_TURNS=20             # Max conversation turns kept in memory
JARVIS_SYSTEM_PROMPT=You are Jarvis, a helpful local AI assistant. Be concise and precise.

# --- Sandbox (M2+) ---
SANDBOX_ROOTS=/Users/m2air/Desktop/Jarvis/sandbox

# --- GitHub & Poetry (M3+) ---
GIT_TOKEN=ghp_yourPersonalAccessTokenHere
DEFAULT_WORKSPACE_DIR=/Users/m2air/Desktop/Jarvis/workspace
POETRY_VENV_PATH=/Users/m2air/Desktop/Jarvis/.venvs
GIT_USER_EMAIL=jarvis@local.ai
GIT_USER_NAME=Jarvis
